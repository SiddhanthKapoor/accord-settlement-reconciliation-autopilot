# Copy to backend/.env and fill in what you have. Everything is optional —
# the system runs fully offline with graceful fallbacks (see README) if
# these are unset; but the two integrations below are what make the demo
# "real" rather than simulated.

# Razorpay TEST-MODE keys (free, no KYC required — see README for where to
# get these). Without these, /execute returns a clear 501 explaining
# what's missing; it never fakes a successful payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Without this, the one AI-assisted check (fuzzy product-name equivalence)
# runs on a deterministic lexical-similarity fallback instead of the real
# classifier — see app/engine/semantic.py and scenarios/semantic_eval.py
# for the honest, separately-measured comparison.
ANTHROPIC_API_KEY=

CATALOG_BASE_URL=http://127.0.0.1:8100
CORS_ORIGINS=http://localhost:5173
