# Copy to backend/.env and fill in what you have. Everything is optional —
# the system runs fully offline with graceful fallbacks (see README) if
# these are unset; but the two integrations below are what make the demo
# "real" rather than simulated.

# Razorpay TEST-MODE keys (free, no KYC required — see README for where to
# get these). Without these, /execute clearly labels its result as
# simulated rather than faking a real payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Primary semantic-classifier provider. Without this (or ANTHROPIC_API_KEY
# below), the one AI-assisted check (fuzzy product-name equivalence) runs
# on a deterministic lexical-similarity fallback instead — see
# app/engine/semantic.py and scenarios/semantic_eval.py for the honest,
# separately-measured comparison between backends.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Alternate provider — used only if GEMINI_API_KEY is not set.
ANTHROPIC_API_KEY=

CATALOG_BASE_URL=http://127.0.0.1:8100
CORS_ORIGINS=http://localhost:5173
