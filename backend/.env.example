# Copy to backend/.env and fill in what you have. Everything is optional —
# the system runs fully offline with a deterministic heuristic fallback
# for the one AI-assisted check if GEMINI_API_KEY is unset (see README's
# "SYNTHETIC EVALUATION" section for the honest, measured comparison
# between the heuristic and Gemini).

# Primary semantic-classifier provider — used only for the residual
# ambiguous-reference cases deterministic matching can't resolve on its
# own (see app/engine/matching.py). Never decides RECONCILED by itself;
# see PolicyConfig.ai_confidence_threshold and app/engine/policy.py.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Enables app/integrations/razorpay_settlements.py's live API calls. See
# README's "Razorpay integration" section for exactly what this can and
# can't demonstrate in a fresh test-mode account (verified empirically:
# a fresh account's settlement.all() and payment.all() both return zero
# items, since settlements require a real completed payment + settlement
# cycle). Free test-mode keys, no KYC required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

CORS_ORIGINS=http://localhost:5173
